{
  "buildCommand": "pnpm --filter @workspace/barcelona-gis run build",
  "outputDirectory": "artifacts/barcelona-gis/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "build": {
    "env": {
      "BASE_PATH": "/",
      "PORT": "3000"
    }
  }
}
